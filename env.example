# ===========================================
# 🚀 ALTROWAY - NETLIFY DEPLOYMENT CONFIG
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ===========================================
# 🔑 SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from: https://supabase.com/dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ===========================================
# 🔐 NEXT.JS AUTHENTICATION (REQUIRED)
# ===========================================

# Your Netlify site URL (update after deployment)
NEXTAUTH_URL=https://your-site-name.netlify.app

# Generate a random secret key (32+ characters)
NEXTAUTH_SECRET=your-super-secret-key-here-make-it-long-and-random

# ===========================================
# 🗄️ DATABASE CONFIGURATION (OPTIONAL)
# ===========================================
# Only needed if you want direct database access

DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ===========================================
# 🌐 NETLIFY SPECIFIC (AUTO-GENERATED)
# ===========================================

# Netlify will automatically set these
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app

# ===========================================
# 📱 ADDITIONAL CONFIGURATION (OPTIONAL)
# ===========================================

# For development only
# NEXT_PUBLIC_APP_ENV=development

# ===========================================
# 🔍 HOW TO GET SUPABASE KEYS
# ===========================================
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy:
#    - Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon/public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key → SUPABASE_SERVICE_ROLE_KEY

# ===========================================
# ⚠️ IMPORTANT SECURITY NOTES
# ===========================================
# - NEVER commit this file to git
# - Keep your service role key secret
# - Use HTTPS URLs for production
# - Generate a strong NEXTAUTH_SECRET
# - Test locally before deploying

# ===========================================
# 🚀 NETLIFY DEPLOYMENT STEPS
# ===========================================
# 1. Fill in all the values above
# 2. Copy this file to .env.local
# 3. Test locally: npm run build && npm start
# 4. Push to GitHub
# 5. Connect to Netlify
# 6. Add environment variables in Netlify dashboard
# 7. Deploy!
